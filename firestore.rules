rules_version = '2';
// Edward 的 Blog：Firestore 安全規則（貼到 Firebase 主控台 → Firestore → 規則）
// 白話：
//   posts（文章標題、摘要）  → 已發布的大家都能看；只有管理員能寫
//   bodies（文章內文）       → 公開文章大家能看；會員限定文章要登入；草稿只有管理員
//   templates（模板）        → 只有管理員
//   members（會員資料）      → 自己看自己、管理員看全部
//   roles（誰是管理員）      → 只能自己讀自己；只能從 Firebase 主控台手動設定，網站改不了
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    // 已核准的會員（Edward 在後台按「核准」才算）
    function isMember() {
      return signedIn() && exists(/databases/$(db)/documents/members/$(request.auth.uid))
        && get(/databases/$(db)/documents/members/$(request.auth.uid)).data.approved == true;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/roles/$(request.auth.uid))
        && get(/databases/$(db)/documents/roles/$(request.auth.uid)).data.admin == true;
    }

    match /posts/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /bodies/{id} {
      // 排程文章：publishedAt（毫秒）還沒到，內文讀不到
      allow read: if isAdmin()
        || (resource.data.status == 'published'
            && (!('publishedAt' in resource.data) || resource.data.publishedAt <= request.time.toMillis())
            && (resource.data.visibility == 'public' || isMember()));
      allow write: if isAdmin();
    }
    match /settings/{id} {          // 網站設定（配色）：大家可讀、只有管理員能改
      allow read: if true;
      allow write: if isAdmin();
    }
    match /briefs/{date} {          // 每日財經早報：你的勾選與微調（大家可讀、只有管理員能改）
      allow read: if true;
      allow write: if isAdmin();
    }
    match /media/{id} {             // 照片庫：縮圖與資訊
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mediaData/{id} {         // 照片庫：壓縮後原圖
      allow read: if true;
      allow write: if isAdmin();
    }
    match /templates/{id} {
      allow read, write: if isAdmin();
    }
    match /members/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      // 註冊時只能建立「等候授權」的自己；不能自己把自己設成核准
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.approved == false && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.approved == resource.data.approved
            && request.resource.data.status == resource.data.status
            // 「Email 已驗證」只有真的點過驗證信才能設成 true
            && (request.resource.data.get('emailVerified', false) == false || request.auth.token.email_verified == true));
      allow delete: if isAdmin();
    }
    match /roles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
