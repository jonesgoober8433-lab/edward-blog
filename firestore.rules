rules_version = '2';
// Edward 的 Blog：Firestore 安全規則（貼到 Firebase 主控台 → Firestore → 規則）
// 白話：
//   posts（文章標題、摘要）  → 已發布的大家都能看；只有管理員能寫
//   bodies（文章內文）       → 公開文章大家能看；會員限定文章要登入；草稿只有管理員
//   templates（模板）        → 只有管理員
//   members（會員資料）      → 自己看自己、管理員看全部
//   roles（誰是管理員）      → 只能自己讀自己；只能從 Firebase 主控台手動設定，網站改不了
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/roles/$(request.auth.uid))
        && get(/databases/$(db)/documents/roles/$(request.auth.uid)).data.admin == true;
    }

    match /posts/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /bodies/{id} {
      // 排程文章：publishedAt（毫秒）還沒到，內文讀不到
      allow read: if isAdmin()
        || (resource.data.status == 'published'
            && (!('publishedAt' in resource.data) || resource.data.publishedAt <= request.time.toMillis())
            && (resource.data.visibility == 'public' || signedIn()));
      allow write: if isAdmin();
    }
    match /settings/{id} {          // 網站設定（配色）：大家可讀、只有管理員能改
      allow read: if true;
      allow write: if isAdmin();
    }
    match /templates/{id} {
      allow read, write: if isAdmin();
    }
    match /members/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
    match /roles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
